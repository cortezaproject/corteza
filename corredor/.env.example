# prod[uction] or dev[elopment] environment?
CORREDOR_ENVIRONMENT=prod

# Where do we listen for gRPC requests?
CORREDOR_ADDR=0.0.0.0:50051

# Is logging enabled
CORREDOR_LOG_ENABLED=true

# Log in pretty, colorful and multiline environment
#
# Otherwise dull but machine readable JSON.
CORREDOR_LOG_PRETTY=false

# Log level we want to output
#
# When not explicitly set it defaults
# to info (or trace, when in development)
# Levels: fatal, error, warn, info, debug, trace, silent
CORREDOR_LOG_LEVEL=info

# Where are the protobuf definitions
#
# Absolute path to the directory holding service-corredor.proto.
# Defaults to def/protobuf in this repository.
#
# CORREDOR_PROTOBUF_PATH=/path/to/def/protobuf

# How Corredor reaches the Human API
#
# Host is combined with the template to build the per-service base URL.
CORREDOR_EXEC_CSERVERS_API_HOST=localhost:1343
CORREDOR_EXEC_CSERVERS_API_BASEURL_TEMPLATE=http://{host}/api/{service}

# Where to look for extensions (colon separated)
#
# Relative paths are resolved against the package root.
CORREDOR_EXT_SEARCH_PATHS=usr:usr/*

# Install extension dependencies on start and on package.json change
CORREDOR_EXT_DEPENDENCIES_AUTO_UPDATE=true

# Package manager used for extension dependencies: yarn, npm or pnpm
#
# When unset, yarn is used if on PATH, npm otherwise.
# CORREDOR_EXT_DEPENDENCIES_INSTALLER=yarn

# TLS for the gRPC server
#
# When enabled, ca.crt, private.key and public.crt are read from
# CORREDOR_SERVER_CERTIFICATES_PATH (default /certs).
CORREDOR_SERVER_CERTIFICATES_ENABLED=false
# CORREDOR_SERVER_CERTIFICATES_PATH=/certs
