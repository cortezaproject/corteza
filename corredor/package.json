{
  "name": "@planetcrust/human-corredor",
  "description": "Human automation script runner",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/server.ts",
  "types": "src/types.ts",
  "scripts": {
    "serve": "tsx ./src/server.ts",
    "serve:dev": "tsx watch ./src/server.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/ tools/",
    "format:check": "prettier --check src/ tools/",
    "docs:scripting": "node tools/scripting-reference.mjs",
    "test:unit": "mocha",
    "test": "pnpm run test:unit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.7.15",
    "@planetcrust/human-js": "workspace:*",
    "@sentry/node": "^10.75.1",
    "axios": "^1.15.0",
    "dotenv": "^18.0.2",
    "glob": "^11.1.0",
    "lodash": "^4.18.0",
    "moment": "2.30.1",
    "node-watch": "^0.7.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.3",
    "webpack": "^5.111.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chai": "^5.0.1",
    "@types/chai-as-promised": "^8.0.1",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.1",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.2.0",
    "mocha": "^12.0.2",
    "prettier": "^3.0.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22"
  }
}
