# Copy to .env.e2e (gitignored) and fill in. E2E attaches to your running dev
# stack — it never boots or seeds anything.
#
# Stack prerequisite: run the server with AUTH_REQUEST_RATE_LIMIT=0 (server
# env). Every fresh browser context does an oauth roundtrip; a full suite run
# trips the default 60/min per-IP auth limit and tests fail on blank 429 pages.
E2E_BASE_URL=http://localhost:5173
E2E_USER=admin@example.tld
E2E_PASS=change-me
