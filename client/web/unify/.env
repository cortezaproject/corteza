VITE_APP_TITLE=Human
# Auth uses the shared /oauth2/default-client flow; with rootApp:true the
# callback is ${origin}/auth/callback regardless of this value, so no per-app
# OAuth registration is needed. (Locale loads the single 'human-webapp' bundle
# set in src/plugins/index.js, not VITE_APP_NAME.)
VITE_APP_ID=unify
VITE_APP_NAME=human-webapp-unify
