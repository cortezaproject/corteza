# Copy to .env.e2e (gitignored) and fill in. The suite attaches to a running
# stack and never boots or seeds anything itself.
#
# Stack prerequisites:
# - server started with AUTH_REQUEST_RATE_LIMIT=0 (every fresh browser context
#   does an OAuth roundtrip and the default per-IP limit trips on a full run)
#   and AUTH_DEFAULT_REDIRECT_URIS covering the webapp dev server URL
# - the compose webapp dev server with public/config.js pointing at that server
# - a user with the super administrator role
E2E_COMPOSE_URL=http://127.0.0.1:8081
E2E_API_URL=http://localhost:1043/api
E2E_USER=e2e-admin@example.tld
E2E_PASS=change-me
