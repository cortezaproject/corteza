# Minimum environment for a local Human dev server.
#
# .env.example documents every option there is (1400+ lines, all commented).
# This file is the other thing you need: the short list that actually matters,
# with what breaks if you leave each one out.
#
#   cp .env.min.example .env
#
# Almost nothing here is strictly required — the server boots with an empty
# .env, using an in-memory database that vanishes on restart. These are the
# values that make it a usable dev environment rather than a demo.

# --- Database ---------------------------------------------------------------
#
# Defaults to "memory" when unset: the server starts, works, and loses
# everything when it restarts. Fine for a smoke test, useless for development.
#
# Postgres is what the team runs. Create the database first; the server creates
# its own tables on boot.
DB_DSN=postgres://human:human@localhost:5432/human

# SQLite needs no server at all, if you want zero infrastructure. Use a file
# path — the in-memory form has the same problem as the default.
# DB_DSN=sqlite3://file:human.sqlite?cache=shared

# --- Where it listens -------------------------------------------------------
#
# HTTP_ADDR is the bind address. DOMAIN must agree with it: it goes into
# generated links, cookies and OAuth redirects, so a mismatch produces logins
# that appear to work and then bounce.
HTTP_ADDR=:1043
DOMAIN=localhost:1043

# The API prefix. dev/agent/* and the webapp both assume /api; changing it
# means changing them too.
HTTP_API_BASE_URL=/api

# --- Development mode -------------------------------------------------------
#
# ENVIRONMENT is not cosmetic. Anything other than "dev" is treated as
# production, and the server then refuses to provision super users
# (pkg/provision/auth.go) — which is what dev/agent/bootstrap.sh needs to
# create the agent-dev user. Leave it unset and the agent toolkit cannot
# authenticate.
ENVIRONMENT=dev

# Serves the auth screens from source rather than the embedded bundle, so
# changes to them show up without a rebuild.
AUTH_DEVELOPMENT_MODE=true

# Every fresh browser context does an oauth roundtrip, so a playwright run
# trips the default 60/min per-IP limit part way through and the remaining
# tests fail on blank 429 pages — which reads exactly like a crashed server.
AUTH_REQUEST_RATE_LIMIT=0

# The MCP token in .mcp.json is exported once, before Claude Code starts, and
# cannot be refreshed while it runs — so at the 2h default the local MCP server
# goes quiet part way through a session and only a restart brings it back.
# Governs the CLI-minted JWT too. Dev only; this is not a production value.
AUTH_OAUTH2_ACCESS_TOKEN_LIFETIME=720h

# Auth clients without their own redirect URIs may only send the browser back
# to the server itself. The Vite dev server is a different origin, so it has
# to be listed here or the login ends on "invalid redirect uri".
AUTH_DEFAULT_REDIRECT_URIS=http://localhost:5173

# --- Worth knowing, not required --------------------------------------------
#
# AUTH_JWT_SECRET is derived from DB_DSN and the hostname when unset, so it
# stays stable across restarts on one machine without being set at all. Set it
# explicitly only when you need tokens to survive a DB_DSN change, or to remain
# valid across two machines.
# AUTH_JWT_SECRET=

# Logging. LOG_LEVEL=debug is loud; the dev server already writes everything to
# server/build/dev.log via `make watch`.
# LOG_LEVEL=info
# LOG_DEBUG=true

# HTTP request/response logging. Useful when a call fails in a way the response
# does not explain, and very noisy otherwise.
# HTTP_LOG_REQUEST=true
# HTTP_LOG_RESPONSE=true
