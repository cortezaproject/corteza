{
  "name": "@planetcrust/human-js",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "rollup -c --environment BUILD:production",
    "build:dev": "rollup -c",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test:unit": "mocha",
    "test": "pnpm run test:unit",
    "codegen": "node tools/codegen/human-api-client.js && prettier --write src/api-clients/*.ts && eslint --fix src/api-clients/*.ts"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "dompurify": "^3.2.4",
    "hex-rgb": "^5.0.0",
    "lodash-es": "^4.18.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "minimatch": "^10.2.3",
    "moment": "2.30.1",
    "numeral": "^2.0.6",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/chai": "^5.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.12.0",
    "@types/numeral": "^2.0.5",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "chai": "^5.1.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "globals": "^16.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "mocha": "^11.1.0",
    "prettier": "^3.0.0",
    "rollup": "^4.32.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-sinon": "2.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browser": {
    "fs": false,
    "path": false
  }
}
