{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash"
    ],
    "deny": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm add*)",
      "Bash(yarn add*)",
      "Bash(yarn install*)",
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(bun add*)",
      "Bash(bun install*)",
      "Bash(npx *)",
      "Bash(bunx *)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(pipx install*)",
      "Bash(uv add*)",
      "Bash(uv pip install*)",
      "Bash(poetry add*)",
      "Bash(go install*)",
      "Bash(go get*)",
      "Bash(cargo install*)",
      "Bash(cargo add*)",
      "Bash(gem install*)",
      "Bash(brew install*)",
      "Bash(brew *)",
      "Bash(apt install*)",
      "Bash(apt-get install*)",
      "Bash(sudo apt*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(scp *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(:(){*)",
      "Bash(chmod -R 777*)",
      "Bash(* | sh)",
      "Bash(* | bash)"
    ]
  }
}
