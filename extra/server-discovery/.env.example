###############################################################################
###############################################################################
#
# This file is maintained by hand, alongside pkg/options/*.go.
#
# Copy it to .env and uncomment set or adjust any options you need.
#
# Unlike the main server's .env.example this one is not generated, so an option
# added to pkg/options must be added here too.

###############################################################################
###############################################################################
# Environment
#

###############################################################################
# Runtime environment; anything starting with `dev` or `test` is treated as
# such, everything else as production.
# Type:    string
# Default: production
# ENVIRONMENT=production

###############################################################################
###############################################################################
# HTTP Server
#

###############################################################################
# IP and port for the HTTP server.
# Type:    string
# Default: :80
# HTTP_ADDR=:80

###############################################################################
# Base URL (prefix) for all routes (<baseUrl>/api, ...)
# Type:    string
# Default: /
# HTTP_BASE_URL=/

###############################################################################
# Base URL for the API routes, internally prefixed with HTTP_BASE_URL.
# Type:    string
# Default: /
# HTTP_API_BASE_URL=/

###############################################################################
# Enable `/healthcheck` route.
# Type:    bool
# Default: true
# HTTP_ENABLE_HEALTHCHECK_ROUTE=true

###############################################################################
# Enable `/version` route.
# Type:    bool
# Default: true
# HTTP_ENABLE_VERSION_ROUTE=true

###############################################################################
# Delays API startup for the amount of time specified (10s, 2m...).
#     This delay happens before service (`WAIT_FOR_SERVICES`) probing.
# Type:    time.Duration
# Default: 0s
# WAIT_FOR=0s

###############################################################################
# Show temporary status web page.
# Type:    bool
# Default: true
# WAIT_FOR_STATUS_PAGE=true

###############################################################################
###############################################################################
# Open search configuration
#

###############################################################################
# IP and port for the open search.
# Use space delimited string to set multiple addresses.
# Type:    []string
# Default: http://es:9200
# ES_ADDRESS=http://es:9200

###############################################################################
# Username for the open search connection.
# Type:    string
# Default:
# ES_USERNAME=

###############################################################################
# Password for the open search connection.
# Type:    string
# Default:
# ES_PASSWORD=

###############################################################################
# Path to the CA certificate file for the open search connection.
# Type:    string
# Default:
# ES_CERT_FILE=

###############################################################################
# Connect to the open search over TLS.
# Type:    bool
# Default: true
# ES_SECURE=true

###############################################################################
# Retry a request that timed out.
# Type:    bool
# Default: true
# ES_ENABLE_RETRY_ON_TIMEOUT=true

###############################################################################
# How many times a failed request to the open search is retried.
# Type:    int
# Default: 5
# ES_MAX_RETRIES=5

###############################################################################
# How often are indexes incremented. set value in seconds.
# Type:    int
# Default: 30
# ES_INDEX_INTERVAL=30

###############################################################################
# How many months back the first indexing run reaches. Zero indexes everything.
# Type:    int
# Default: 0
# ES_INDEX_BACKFILL_MONTHS=0

###############################################################################
###############################################################################
# Human server configuration
#

###############################################################################
# IP and port for the human server.
# Type:    string
# Default: http://server:80
# HUMAN_SERVER_BASE_URL=http://server:80

###############################################################################
# human server auth url.
# Type:    string
# Default: HUMAN_SERVER_BASE_URL with /auth appended, so http://server:80/auth
# HUMAN_SERVER_AUTH_URL=

###############################################################################
# human server url for the discovery api.
# Type:    string
# Default: HUMAN_SERVER_BASE_URL with /api/discovery appended, so http://server:80/api/discovery
# HUMAN_SERVER_DISCOVERY_URL=

###############################################################################
###############################################################################
# Human discovery indexer configuration
#

###############################################################################
# Enables indexing for human resources.
# Type:    bool
# Default: true
# DISCOVERY_INDEXER_ENABLED=true

###############################################################################
# Client key and secret used to index human resources at one visibility.
# PREFIX is one of 'public', 'protected' or 'private'.
#
# Required. Without at least one complete pair the server stops with:
#     set at least one client secret pair using
#     DISCOVERY_INDEXER_<PREFIX>_INDEX_CLIENT_KEY and
#     <PREFIX>_INDEX_CLIENT_SECRET
# Type:    string
# DISCOVERY_INDEXER_PUBLIC_INDEX_CLIENT_KEY=
# DISCOVERY_INDEXER_PUBLIC_INDEX_CLIENT_SECRET=

###############################################################################
###############################################################################
# Human discovery searcher configuration
#

###############################################################################
# Enables searching for human resources and also enables search endpoints.
# Type:    bool
# Default: true
# DISCOVERY_SEARCHER_ENABLED=true

###############################################################################
# Used to restrict human resources based on client permissions.
#
# Required. The server stops with "client key (...) is empty or missing" when
# either of these is unset.
# Type:    string
# DISCOVERY_SEARCHER_CLIENT_KEY=
# DISCOVERY_SEARCHER_CLIENT_SECRET=

###############################################################################
# It enables access to private indexing.
# Type:    string
# Default:
# DISCOVERY_SEARCHER_JWT_SECRET=

###############################################################################
# Space delimited list of roles allowed to search.
# Type:    string
# Default:
# DISCOVERY_SEARCHER_ALLOWED_ROLE=

###############################################################################
###############################################################################
# Vector search configuration
#

###############################################################################
# How search queries are answered: `traditional`, `semantic` or `hybrid`.
# The latter two need the embeddings options below.
# Type:    string
# Default: traditional
# SEARCH_MODE=traditional

###############################################################################
# Endpoint of the service that turns text into embeddings.
# Type:    string
# Default:
# EMBEDDINGS_API_URL=

###############################################################################
# API key for the embeddings service.
# Type:    string
# Default:
# EMBEDDINGS_API_KEY=

###############################################################################
# Model the embeddings service is asked for.
# Type:    string
# Default: paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
